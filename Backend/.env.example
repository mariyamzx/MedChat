# ==========================================================
# MongoDB Atlas
# ==========================================================
# Atlas -> Connect -> Drivers -> Python. Replace <password> with your real
# password. If the password has special characters, URL-encode them
# (@ becomes %40, # becomes %23, etc) or the URI will fail to parse.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=medicine_chatbot

# ==========================================================
# LLM provider  ("groq" or "huggingface")
# ==========================================================
LLM_PROVIDER=groq

# Groq (recommended) — free tier, fast, and supports guaranteed JSON output.
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Hugging Face (fallback)
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2

# ==========================================================
# Safety pipeline
# ==========================================================
MAX_SAFETY_RETRIES=3

# ==========================================================
# CORS — add your frontend's dev URL here if it isn't listed
# ==========================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
