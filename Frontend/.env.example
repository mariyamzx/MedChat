# Where the MedChat backend is running.
# This is the ONLY thing the frontend needs configured.
#
# Vite only exposes variables prefixed with VITE_ to the browser, so the name
# matters. After changing this, restart the dev server — Vite reads .env at
# startup, not on hot reload.
VITE_API_BASE_URL=http://127.0.0.1:8000
